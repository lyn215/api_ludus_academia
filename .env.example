# === LudusAcademia v2.1 — Variables de entorno ===

APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000

# DATABASE_URL para Render + Supabase pooler (Transaction Mode, Puerto 6543)
# IMPORTANTE: Usa el host pooler.supabase.com y puerto 6543
# El parámetro statement_cache_size=0 se agrega automáticamente
DATABASE_URL=postgresql+asyncpg://postgres.bbyhevcprqxntsaknwul:[YOUR-PASSWORD]@aws-1-us-east-1.pooler.supabase.com:6543/postgres

# Supabase (Project Settings → API)
SUPABASE_URL=https://XXXXXXXXX.supabase.co
SUPABASE_JWT_SECRET=tu-legacy-jwt-secret
SUPABASE_ANON_KEY=tu-anon-key

# CORS — arquitectura SPA directa
ALLOWED_ORIGINS=https://yourdomain.com,https://tu-frontend.onrender.com

# Límites
MAX_SYNC_PAYLOAD_KB=50
INVITE_CODE_EXPIRY_HOURS=24

