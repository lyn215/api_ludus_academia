# === LudusAcademia v2.1 — Variables de entorno ===

APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000

# DATABASE_URL para Render + Supabase pgbouncer (Transaction Mode, Puerto 6543)
# IMPORTANTE: Agrega ?statement_cache_size=0 al final de la URL
# Formato: postgresql+asyncpg://[usuario]:[password]@[host]:6543/postgres?statement_cache_size=0
DATABASE_URL=postgresql+asyncpg://postgres.XXXXXXXXX:XXXXXXXXX@aws-1-us-east-1.pooler.supabase.com:6543/postgres?statement_cache_size=0

# Supabase (Project Settings → API)
SUPABASE_URL=https://XXXXXXXXX.supabase.co
SUPABASE_JWT_SECRET=tu-legacy-jwt-secret
SUPABASE_ANON_KEY=tu-anon-key

# CORS — arquitectura SPA directa
ALLOWED_ORIGINS=https://yourdomain.com,https://tu-frontend.onrender.com

# Límites
MAX_SYNC_PAYLOAD_KB=50
INVITE_CODE_EXPIRY_HOURS=24

