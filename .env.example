# === LudusAcademia v2.1 — Variables de entorno ===

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_PATH=./ludusacademia.db

# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_JWT_SECRET=tu-legacy-jwt-secret
SUPABASE_ANON_KEY=tu-anon-key

# CORS — arquitectura SPA directa
ALLOWED_ORIGINS=http://localhost:5173,https://tu-frontend.onrender.com

# Límites
MAX_SYNC_PAYLOAD_KB=50
INVITE_CODE_EXPIRY_HOURS=24
